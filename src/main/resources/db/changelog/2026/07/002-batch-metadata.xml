<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A-39b resolved: Liquibase-owned copy of the Spring Batch 6.0.4
         postgres DDL, table-prefixed per service (MSX_BATCH_) for
         single-writer cleanliness (R-34), EXIT_MESSAGE widened to TEXT so
         CRDB-driver cause chains are never truncated. -->
    <!-- LIQUIBASE-SQL-EXCEPTION: the batch metadata is the vendor-autogenerated
         Spring Batch 6 postgres schema loaded verbatim via <sqlFile> (fleet
         pattern, identical to mrr/mrv/mrw/ixr); it is not hand-authored DDL to
         re-express as typed tags, and it is DB-portable CREATE TABLE only. -->
    <changeSet id="002-batch-metadata-msx" author="dcre">
        <!-- A-81: the sqlFile gained IF NOT EXISTS on every CREATE, which CHANGES this
             changeset's checksum and would fail validation on every database that had
             already executed it ("was: 9:6745... but is now: 9:fcef..."), observed live on
             MRR. Liquibase's documented escape hatch is the right one here rather than a
             new id per service: the content is autogenerated framework DDL whose integrity
             is now guaranteed by the IF NOT EXISTS clauses themselves, so re-running it
             cannot damage a database in any state. Applying it is what must stay possible;
             the byte-for-byte checksum is not the control that matters for this file. -->
        <validCheckSum>ANY</validCheckSum>
        <sqlFile path="db/changelog/2026/07/batch-metadata-msx.sql" splitStatements="true"/>
    </changeSet>

</databaseChangeLog>
